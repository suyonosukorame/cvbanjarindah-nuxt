# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-publishable-or-anon-key

# Google Gemini API
NUXT_PUBLIC_GEMINI_API_KEY=your-gemini-api-key

# Application Configuration
NUXT_PUBLIC_APP_NAME=CV Banjar Indah
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare (optional, for future deployment)
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token

# Cloudinary Configuration
NUXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NUXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
